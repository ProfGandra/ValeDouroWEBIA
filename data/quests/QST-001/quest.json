  "narrative_guardrails": [
    {
      "type": "instruction",
      "text": "Os bandidos não sabotaram a carroça."
    },
    {
      "type": "instruction",
      "text": "Os bandidos não sequestraram o aprendiz."
    },
    {
      "type": "instruction",
      "text": "O mercador está sinceramente enganado; não está mentindo."
    },
    {
      "type": "instruction",
      "text": "O chefe da escolta deve poder afirmar honestamente: 'Não vi ninguém levando o garoto.'"
    },
    {
      "type": "instruction",
      "text": "A falha mecânica é anterior ao ataque e deve permanecer coerente com desgaste progressivo."
    },
    {
      "type": "instruction",
      "text": "Não transformar automaticamente ausência de sinais de arrasto/escolta em prova absoluta de que não houve sequestro."
    },
    {
      "type": "instruction",
      "text": "Não mudar a verdade da Quest para acompanhar hipóteses dos jogadores."
    },
    {
      "type": "instruction",
      "text": "Não criar monstro, novo vilão ou obstáculo compensatório apenas porque os jogadores resolveram uma etapa rapidamente."
    },
    {
      "type": "instruction",
      "text": "Não bloquear magia apenas para preservar a investigação planejada."
    },
    {
      "type": "instruction",
      "text": "Se os jogadores priorizarem os bandidos, a condição do aprendiz pode evoluir naturalmente devido a ferimento, isolamento e passagem do tempo; isso não é punição."
    },
    {
      "type": "instruction",
      "text": "Se os jogadores localizarem rapidamente o aprendiz por uma solução plausível, permitir que a Quest avance ou termine sem fabricar dificuldade adicional."
    }
  ],
