      "truth": true
    },
    {
      "id": "PRP-004",
      "statement": "Uma marca observada em árvore está aproximadamente a 2,2 m do solo.",
      "truth": true
    },
    {
      "id": "PRP-005",
      "statement": "A marca de 2,2 m prova que a criatura mede 2,2 m de altura.",
      "truth": false
